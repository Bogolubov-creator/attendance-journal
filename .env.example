# Для локального просмотра достаточно npm run dev.
# Для сервера заполнить значения и скопировать в .env.
DOMAIN=attendance.example.edu
APP_ORIGIN=https://attendance.example.edu
DEMO_MODE=false
# Выбор роли и имени без университетской авторизации.
AUTH_MODE=selection
HOST=127.0.0.1
PORT=3100
# Вход через университетский OIDC (AUTH_MODE не selection): адрес провайдера
# с https://, идентификатор и секрет клиента. Значения выдаёт ИТ-служба.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Закомментированные строки ниже оставляют умолчание.
# true – проверять настройки OIDC при запуске и в демонстрационном режиме
# (так задано в compose.yaml); в рабочем режиме с OIDC она идёт всегда.
# При AUTH_MODE=selection ни на что не влияет.
# REQUIRE_AUTH_CONFIG=false
# Файл базы SQLite; без значения – data/attendance.sqlite (в демо – data/demo.sqlite).
# На Mac держать вне папок, которые синхронизирует iCloud.
# DB_PATH=data/attendance.sqlite
# Файл реестра для первого запуска с пустой базой; дальше реестр живёт в базе.
# ROSTER_PATH=data/roster.json
# Папка со сканами документов кабинета студента. Веб-сервер её не раздаёт –
# файл выдаётся только через GET /api/attachments/:id с проверкой прав.
# Резервировать отдельно от базы и вместе с ней (см. deploy/DEPLOY.md).
UPLOAD_DIR=data/uploads
AUTO_BACKUP=true
BACKUP_DIR=data/backups
# Сколько последних копий хранить; лишние удаляются после очередной копии.
BACKUP_KEEP=14
# Число своих обратных прокси перед приложением: за Caddy из compose.yaml – 1.
# Без этого значения счётчик попыток пароля общий на всех посетителей за прокси.
TRUST_PROXY=1
# Хеш общего пароля для всех ролей (scrypt); при пустом значении вход закрыт.
MANAGEMENT_PASSWORD_HASH=

# DATA_MODE=live скрывает отметку тестовой базы; способ входа не меняется.
DATA_MODE=preview

# --- Временный шлюз с паролем (scripts/access-proxy.mjs), не само приложение ---
# Приложение эти переменные не читает; их задают при запуске шлюза.
# Обязательно для шлюза: файл с логином и SHA-256 пароля; без него шлюз не стартует.
# В репозиторий не кладётся.
# ACCESS_CONFIG=
# Порт, который слушает шлюз (по умолчанию 3112).
# GATEWAY_PORT=3112
# Адрес и порт приложения, куда шлюз передаёт запросы (по умолчанию 127.0.0.1:3100).
# APP_HOST=127.0.0.1
# APP_PORT=3100
