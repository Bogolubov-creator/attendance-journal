# Для локального просмотра достаточно npm run dev.
# Для сервера заполнить значения и скопировать в .env.
DOMAIN=attendance.example.edu
APP_ORIGIN=https://attendance.example.edu
DEMO_MODE=false
# Выбор роли и имени без университетской авторизации.
AUTH_MODE=selection
HOST=127.0.0.1
PORT=3100
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Автоматическое создание только преподавателей, после проверенного входа.
AUTO_ENROLL_TEACHERS=false
AUTO_SYNC=true
SYNC_INTERVAL_MINUTES=360
AUTO_BACKUP=true
BACKUP_DIR=data/backups
# Хеш пароля руководства (scrypt); при пустом значении вход руководства закрыт.
MANAGEMENT_PASSWORD_HASH=
